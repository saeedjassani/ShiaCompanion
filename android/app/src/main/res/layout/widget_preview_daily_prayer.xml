<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for API 31+ hosts. Mirrors DailyPrayerTimesWidgetContent in
     ShiaCompanionGlanceWidgets.kt; sample data only, never rendered on a
     placed widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@string/widget_preview_location"
            android:src="@drawable/ic_widget_location"
            android:tint="@color/widget_secondary_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_preview_location"
            android:textColor="@color/widget_secondary_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="@string/widget_preview_countdown"
            android:textColor="@color/widget_body_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_icon_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_preview_fajr"
                    android:src="@drawable/ic_prayer_fajr"
                    android:tint="@color/widget_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_fajr"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_fajr_time"
                android:textColor="@color/widget_body_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_icon_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_preview_zuhr"
                    android:src="@drawable/ic_prayer_zuhr"
                    android:tint="@color/widget_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_zuhr"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_zuhr_time"
                android:textColor="@color/widget_body_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_icon_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_preview_asr"
                    android:src="@drawable/ic_prayer_asr"
                    android:tint="@color/widget_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_asr"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_asr_time"
                android:textColor="@color/widget_body_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_icon_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_preview_maghrib"
                    android:src="@drawable/ic_prayer_maghrib"
                    android:tint="@color/widget_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_maghrib"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_maghrib_time"
                android:textColor="@color/widget_body_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_icon_badge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_preview_isha"
                    android:src="@drawable/ic_prayer_isha"
                    android:tint="@color/widget_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_isha"
                android:textColor="@color/widget_secondary_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@string/widget_preview_isha_time"
                android:textColor="@color/widget_body_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
