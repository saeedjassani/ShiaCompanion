{
  "segments": {
    "0": "બોલતા પહેલાં ઇસ્તિગફાર",
    "1": "દરેક નમાઝના સલામ પછી, વાત કરતાં કે બીજું કંઈ કરતાં પહેલાં અને તમારી જગ્યાએથી હલ્યા વિના, પઢો:",
    "6": "સલવાત અને બીબી ફાતિમા (સ.અ.)ની તસ્બીહ",
    "8": "બીબી ફાતિમા ઝહરા (સ.અ.)ની તસ્બીહ, દરેક નમાઝ પછી પઢવાની - 34 વખત:",
    "10": "33 વખત:",
    "12": "33 વખત:",
    "14": "એક વખત:",
    "16": "સુબ્હાનલ્લાહ વલ હમ્દુલિલ્લાહ",
    "20": "માશાઅલ્લાહ અને યા ફત્તાહ ×70",
    "22": "જમણો હાથ છાતી પર રાખીને 70 વાર પઢો:",
    "24": "દુઆ તવક્કલ્તુ અલલ હય્ય",
    "33": "સલવાત અને વિર્દ ×100",
    "34": "ફજરની નમાઝ પછી પઢો:",
    "38": "10 વાર પઢો:",
    "46": "આમાંથી દરેક 100 વાર પઢો:",
    "53": "દુઆ યા માલિકર રિકાબ",
    "54": "ચાર કુલ ([કાફિરૂન](A113), [ઇખ્લાસ](A116), [ફલક](A117), [નાસ](A118)) પઢો, પછી આ દુઆ:",
    "60": "દુઆ અસ્બહ્તુ અલ્લાહુમ્મ",
    "76": "ઈમાન અને તંદુરસ્તી માટેની દુઆ",
    "82": "દુઆએ અહદ",
    "99": "મોમિનો માટે માફી ×25",
    "100": "25 વાર પઢો:",
    "102": "નૂર, બસીરત અને યકીન માટેની દુઆ",
    "109": "દુઆ લા ઇલાહ ઇલ્લલ્લાહ અલ-જલીલ",
    "110": "ફજરની નમાઝ પછી આ દુઆ પઢો. તેને તા'વીઝ તરીકે શરીર પર પણ રાખી શકાય છે.",
    "125": "સૂરએ કદ્ર, યાસીન અને ઇખ્લાસ",
