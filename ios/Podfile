# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

use_frameworks! :linkage => :static

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# firebase_analytics pins the FirebaseAnalytics pod to exactly the Firebase SDK
# version firebase_core names. Firebase iOS 12.19.3 (the eMudhra certificate
# fix) republished only Firebase, FirebaseCore and FirebaseFirestore(Internal),
# so "FirebaseAnalytics = 12.19.3" names a pod that does not exist and
# `pod install` fails. Accept any patch of that minor release instead
# ("~> 12.19.0"), as the Firebase umbrella pod itself does for every pod it
# did not republish. Only an exact X.Y.Z pin on that one plugin is touched;
# drop this once a firebase_analytics release no longer needs it (pod install
# then resolves the same with or without it).
module RelaxFirebaseAnalyticsPin
  def dependency(*args)
    name, *requirements = args
    if self.name == 'firebase_analytics' &&
       name.to_s.split('/').first == 'FirebaseAnalytics' &&
       requirements.length == 1 &&
       (match = requirements.first.to_s.strip.match(/\A=?\s*(\d+)\.(\d+)\.\d+\z/))
      args = [name, "~> #{match[1]}.#{match[2]}.0"]
    end
    super(*args)
  end
end
Pod::Specification.prepend(RelaxFirebaseAnalyticsPin)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Ensure all pods use the same minimum iOS deployment target required by some plugins
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      if target.name == 'geolocator_apple'
        definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = [definitions] if definitions.is_a?(String)
        unless definitions.include?('BYPASS_PERMISSION_LOCATION_ALWAYS=1')
          definitions << 'BYPASS_PERMISSION_LOCATION_ALWAYS=1'
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
      end
    end
  end
end